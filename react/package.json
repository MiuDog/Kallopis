{
	"name": "@kallopis/react",
	"version": "0.1.0",
	"description": "Kallopis shared semantic design system for React",
	"private": true,
	"type": "module",
	"files": [
		"dist",
		"README.md"
	],
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": {
			"types": "./dist/styles.d.ts",
			"default": "./dist/styles.css"
		}
	},
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"generate": "node scripts/generate-tokens.mjs",
		"check:tokens": "node scripts/generate-tokens.mjs --check",
		"build": "npm run generate && tsc && node scripts/package-assets.mjs",
		"test": "node --test test/*.test.mjs",
		"dev": "vite --host 127.0.0.1",
		"build:example": "tsc -p tsconfig.example.json && vite build",
		"preview": "vite preview --host 127.0.0.1"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"jsdom": "^28.0.0"
	},
	"engines": {
		"node": ">=24"
	}
}

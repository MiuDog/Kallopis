{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://kallopis.dev/schema/semantic-manifest-v1.json",
	"title": "Kallopis semantic manifest",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "id", "scope", "consumerPolicy", "layers"],
	"properties": {
		"$schema": {"type": "string"},
		"schemaVersion": {"const": 1},
		"id": {"const": "kallopis.default"},
		"scope": {"type": "string", "minLength": 1},
		"consumerPolicy": {
			"type": "object",
			"additionalProperties": false,
			"required": ["overridable", "derivations", "locked", "isolatedFrom"],
			"properties": {
				"overridable": {"const": ["color.identity.brand"]},
				"derivations": {
					"const": {
						"color.action.primary": {
							"from": "color.identity.brand",
							"backgroundAlpha": 255,
							"brightnessMetric": "srgb-luma-601",
							"brightnessScale": 255,
							"lightForegroundMax": 159,
							"darkForegroundMin": 160
						}
					}
				},
				"locked": {"const": ["primitive", "foundation", "component", "pattern"]},
				"isolatedFrom": {"const": ["user-design-system.recipe"]}
			}
		},
		"layers": {
			"type": "array",
			"minItems": 4,
			"maxItems": 4,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "label", "description", "pages"],
				"properties": {
					"id": {"enum": ["primitive", "foundation", "component", "pattern"]},
					"label": {"type": "string", "minLength": 1},
					"description": {"type": "string", "minLength": 1},
					"pages": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["id", "source", "symbol"],
							"properties": {
								"id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
								"source": {"type": "string", "pattern": "^[a-z0-9_]+\\.dart$"},
								"symbol": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]+Page$"}
							}
						}
					}
				}
			}
		}
	}
}
